# Copy this file to .env and fill in your keys. Never commit the real .env.

# Required for the script module (https://console.anthropic.com) — generates
# original narration text per video so scripts are never reused/templated.
ANTHROPIC_API_KEY=

# Required for the voiceover module: a locally running Zahra Studio instance
# (free, cloned-voice TTS — see voice_cloning_studio/ on the
# claude/voice-note-script-generation branch of this repo). Start it with
# `uvicorn backend.main:app --port 8000` (or start_backend.bat/.sh) before
# running `meditate create`.
ZAHRA_STUDIO_BASE_URL=http://localhost:8000
# Required: the name of a voice you've already cloned in Zahra Studio
# (Clone New Voice tab, or POST /clone-voice). Check GET /voices for the list.
ZAHRA_VOICE_NAME=

# At least one of these is required for the visuals module (both are free tiers)
PEXELS_API_KEY=
PIXABAY_API_KEY=
