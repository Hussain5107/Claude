# Copy to .env and adjust if needed. All values shown are defaults.
QV_VOICES_DIR=voices
QV_OUTPUT_DIR=output
QV_LOG_LEVEL=INFO
QV_MAX_TEXT_CHARS=200000
QV_CHUNK_MAX_CHARS=400
QV_DEFAULT_LENGTH_SCALE=1.0
QV_JOB_RETENTION_SECONDS=3600

# Frontend only: where the Gradio UI looks for the backend.
QV_BACKEND_URL=http://localhost:8100
