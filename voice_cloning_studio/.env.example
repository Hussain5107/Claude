# Copy this file to .env and adjust as needed. All values shown are defaults.

# Logging
LOG_LEVEL=INFO

# Upload validation
MAX_UPLOAD_MB=50

# Text/generation limits
MAX_TEXT_CHARS=200000
CHUNK_MAX_CHARS=300
CHUNK_GAP_SENTENCE_SEC=0.15
CHUNK_GAP_PARAGRAPH_SEC=0.5

# Model / generation defaults
DEFAULT_EXAGGERATION=0.5
DEFAULT_CFG_WEIGHT=0.5
DEFAULT_TEMPERATURE=0.8
DEFAULT_LANGUAGE=en

# Performance
# Number of CPU threads torch uses for generation (intra-op). Defaults to all cores.
TORCH_NUM_THREADS=
# Inter-op thread pool. Keep low (1-2) for this single-request workload --
# PyTorch's own guidance; more just adds contention instead of speed here.
TORCH_NUM_INTEROP_THREADS=1
# Force a specific device instead of auto-detecting CUDA: "cuda" or "cpu".
DEVICE_OVERRIDE=
# Log a per-stage timing breakdown (model load, inference, post-processing,
# real-time factor) after every generation.
ENABLE_PIPELINE_PROFILING=true

# How long finished job results stay downloadable before cleanup (seconds).
JOB_RETENTION_SECONDS=3600

# Quality: auto-retry a chunk once if Chatterbox's own repetition-safety cuts it short.
MAX_CHUNK_RETRIES=1

# Post-processing applied to the final stitched audio.
ENABLE_LOUDNESS_NORMALIZATION=true
TARGET_LUFS=-19.0
ENABLE_SILENCE_TRIM=true
SILENCE_TRIM_THRESHOLD_DB=-50.0
