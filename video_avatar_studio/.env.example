# Copy this file to .env and adjust as needed. All values shown are defaults
# except REPLICATE_API_TOKEN, which you must set.

# Logging
LOG_LEVEL=INFO

# Upload validation
MAX_UPLOAD_MB=50
MAX_SCRIPT_CHARS=20000

# Zahra Studio (voice cloning backend) -- must already be running.
# See ../voice_cloning_studio (branch claude/voice-note-script-generation-ome6cm).
ZAHRA_API_URL=http://localhost:8000
ZAHRA_REQUEST_TIMEOUT=30
ZAHRA_POLL_INTERVAL_SEC=2.0

# Replicate (talking-head render backend) -- get a token at
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# "sadtalker" (cheaper, natural head motion from a single photo) or
# "musetalk" (higher-fidelity lip-sync)
RENDER_BACKEND=sadtalker
RENDER_POLL_INTERVAL_SEC=3.0
RENDER_TIMEOUT_SEC=1800

# How long finished job results stay downloadable before cleanup (seconds).
JOB_RETENTION_SECONDS=3600
